{
  "name": "@leocavalcante/pi-otel",
  "version": "0.1.2",
  "description": "Export metadata-only OpenTelemetry from Pi coding-agent sessions and Pi Durable agents.",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/leocavalcante/pi-otel.git" },
  "homepage": "https://github.com/leocavalcante/pi-otel#readme",
  "bugs": "https://github.com/leocavalcante/pi-otel/issues",
  "keywords": ["pi-extension", "pi-package", "pi-coding-agent", "pi-durable", "opentelemetry", "otlp", "observability", "llm-observability", "tracing", "telemetry"],
  "engines": { "node": ">=22.19.0" },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }, "./extension": "./dist/extension.js", "./package.json": "./package.json" },
  "pi": { "extensions": ["./src/extension.ts"] },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [],
  "files": ["dist", "src", "examples", "docs", "README.md", "LICENSE", "CHANGELOG.md"],
  "scripts": {
    "check": "tsc -p tsconfig.json && tsc -p tests && tsc -p examples",
    "build": "tsc -p tsconfig.build.json",
    "test": "bun run test:bun && bun run test:node",
    "test:bun": "bun test --timeout 30000 --preload ./tests/environment.ts",
    "test:node": "node --import ./tests/environment.ts --import jiti/register --test --test-concurrency=1 tests/*.node-test.ts",
    "check:package": "bun run build && publint && node .github/scripts/check-package.mjs",
    "verify": "bun run check && bun run test && bun run check:package && bun audit"
  },
  "dependencies": {
    "@earendil-works/pi-telemetry": "1.5.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/core": "3.1.0",
    "@opentelemetry/resources": "3.1.0",
    "@opentelemetry/sdk-trace": "3.1.0",
    "@opentelemetry/sdk-metrics": "3.1.0",
    "@opentelemetry/sdk-logs": "3.1.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.301.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.301.0"
  },
  "peerDependencies": { "@earendil-works/pi-ai": "^1.5.0", "@earendil-works/pi-coding-agent": "*" },
  "peerDependenciesMeta": { "@earendil-works/pi-coding-agent": { "optional": true } },
  "devDependencies": {
    "@earendil-works/pi-durable": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@types/bun": "1.4.4",
    "@types/node": "22.19.1",
    "jiti": "2.7.0",
    "publint": "0.3.25",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  }
}
